# =============================================================================
# 说明：原来的规则写成  "*.mdf"  （带引号）——在 .gitignore 里引号不是语法，
# 会被当成文件名的一部分，所以那两条规则实际是失效的。下面重写为正确写法。
# =============================================================================

# ---------- Python 编译产物 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# ---------- 虚拟环境 ----------
# 常规写法：venv 装在自己的目录里
venv/
.venv/
env/
ENV/

# 本项目的历史遗留：虚拟环境的 Lib/Include/Scripts 直接挂在了项目根目录下
# （管理系统/learning-assistant/），所以需要单独列出来，否则下次又会被提交
Lib/
Include/
Scripts/
pyvenv.cfg

# ---------- 环境变量与凭据（绝对不要提交） ----------
# 已被公开过的密钥/密码必须去后台轮换，删文件改历史都没用
.env
.env.*
!.env.example

# ---------- 数据库文件 ----------
*.db
*.sqlite
*.sqlite3
*.mdf
*.ldf
*.bak

# ---------- IDE / 编辑器 ----------
.idea/
.vscode/
*.swp
*.swo

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 日志 / 临时文件 ----------
*.log
logs/
*.tmp

# ---------- 其他不应入库的常见产物 ----------
node_modules/
dist/
coverage/
.pytest_cache/
.mypy_cache/
